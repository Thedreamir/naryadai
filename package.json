    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "photoServerDependencies": {
    "manifest": "server/photo-ingest/requirements.txt",
    "python": ">=3.10",
    "Pillow": "12.3.0",
    "ImageHash": "4.3.2",
    "numpy": "2.2.6",
    "scope": "local optional bounded decoder; not npm packages"
