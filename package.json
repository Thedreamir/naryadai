{
  "name": "naryadai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "setup:photo": "python3 -m pip install -r server/photo-ingest/requirements.txt",
    "check:photo": "python3 -c \"import PIL, imagehash; assert imagehash.__version__ == '4.3.2'; print('photo dependencies ready')\"",
    "build:telegram": "tsc -p tsconfig.telegram.json",
    "pretest": "npm run build:telegram"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/inter": "^5.3.0",
